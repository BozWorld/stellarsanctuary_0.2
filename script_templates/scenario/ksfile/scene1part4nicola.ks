[chara_show  name="Klaus"  time="500"  wait="false"  storage="chara/2/klaus_closed.png"  width="495"  height="720"  left="600"  top="0"  reflect="false"  ]
[chara_move  name="Nicola"  anim="false"  time="500"  effect="linear"  wait="true"  left="280"  top="0"  width="495"  height="720"  ]

[current layer="message0"]
[layopt layer="message1" visible=false]
